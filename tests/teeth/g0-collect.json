      "file": "../../src/lastlight/g0/collect.py",
      "oracle": "real",
      "find": "_Dropped(\"hrrr_field_empty\"",
      "replace": "_Dropped(\"hrrr_unreadable\""
    },
    {
      "label": "drop detail: URLs not scrubbed",
      "file": "../../src/lastlight/g0/collect.py",
      "oracle": "real",
      "find": "text = _URL.sub(\"the archive\", text)",
      "replace": "text = text"
    },
    {
      "label": "drop detail: archive file names (cycle hour) not scrubbed",
      "file": "../../src/lastlight/g0/collect.py",
      "oracle": "real",
      "find": "text = _RUN_FILE.sub(\"the archive file\", text)",
      "replace": "text = text"
    },
    {
