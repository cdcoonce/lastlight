  "mutants": [
    {
      "label": "drop: any fetch error reads as a missing file",
      "file": "../../src/lastlight/g0/collect.py",
      "oracle": "real",
      "find": "    if is_not_found(error):\n        return _Dropped(missing_reason",
      "replace": "    if True:\n        return _Dropped(missing_reason"
