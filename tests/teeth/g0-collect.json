    {
      "label": "study: a dropped record is counted as used",
      "file": "../../src/lastlight/g0/analysis.py",
      "oracle": "real",
      "find": "elif record.ok:",
      "replace": "elif True:"
    },
    {
      "label": "drop detail: neither URL nor archive file name scrubbed (both scrubbers removed)",
      "file": "../../src/lastlight/g0/collect.py",
      "oracle": "real",
      "find": "    text = _URL.sub(\"the archive\", text)\n    text = _RUN_FILE.sub(\"the archive file\", text)\n",
      "replace": ""
