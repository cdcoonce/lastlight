    {
      "label": "drop: a missing file reads as a fault",
      "file": "../../src/lastlight/g0/collect.py",
      "oracle": "real",
      "find": "    if is_not_found(error):\n        return _Dropped(missing_reason",
      "replace": "    if False:\n        return _Dropped(missing_reason"
    },
    {
      "label": "drop: network fault recorded as a dropped date",
      "file": "../../src/lastlight/g0/collect.py",
      "oracle": "real",
