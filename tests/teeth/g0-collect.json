      "label": "record: schema version not checked",
      "file": "../../src/lastlight/g0/record.py",
      "oracle": "real",
      "find": "if document.get(\"schema_version\") != SCHEMA_VERSION:",
      "replace": "if False:"
    },
    {
      "label": "record: non-finite values accepted",
      "file": "../../src/lastlight/g0/record.py",
      "oracle": "real",
      "find": "if not np.isfinite(array).all():",
      "replace": "if False:"
