      "oracle": "real",
      "find": "reason = \"hrrr_field_missing\" if _FIELD_MISSING in str(error) else \"hrrr_unreadable\"",
      "replace": "reason = \"hrrr_unreadable\" if _FIELD_MISSING in str(error) else \"hrrr_field_missing\""
    },
    {
      "label": "drop reason: HRRR run missing mislabelled as aerosol",
      "file": "../../src/lastlight/g0/collect.py",
      "oracle": "real",
      "find": "_classify_fetch(error, \"hrrr_run_missing\", \"HRRR\")",
      "replace": "_classify_fetch(error, \"aerosol_run_missing\", \"HRRR\")"
    },
    {
      "label": "drop reason: aerosol run missing mislabelled as HRRR",
      "file": "../../src/lastlight/g0/collect.py",
      "oracle": "real",
      "find": "_classify_fetch(error, \"aerosol_run_missing\", \"GEFS-Aerosols\")",
      "replace": "_classify_fetch(error, \"hrrr_run_missing\", \"GEFS-Aerosols\")"
    },
    {
      "label": "drop reason: unreadable aerosol mislabelled as missing run",
      "file": "../../src/lastlight/g0/collect.py",
      "oracle": "real",
      "find": "_Dropped(\"aerosol_unreadable\"",
      "replace": "_Dropped(\"aerosol_run_missing\""
    },
    {
