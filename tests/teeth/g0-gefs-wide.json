{
  "runner": "pytest",
  "test_command": [
    "uv",
    "run",
    "--frozen",
    "pytest",
    "-q",
    "-p",
    "no:cacheprovider",
    "tests/test_gefs.py",
    "tests/test_g0_collect.py",
    "tests/test_g0_report.py",
    "tests/test_g0_command.py",
    "tests/test_g0_study.py",
    "tests/test_g0_record.py",
    "tests/test_hrrr_grib.py"
  ],
  "collect_command": [
    "uv",
    "run",
    "--frozen",
    "pytest",
    "--collect-only",
    "-q",
    "tests/test_gefs.py",
    "tests/test_g0_collect.py",
    "tests/test_g0_report.py",
    "tests/test_g0_command.py",
    "tests/test_g0_study.py",
    "tests/test_g0_record.py",
    "tests/test_hrrr_grib.py"
  ],
  "mutants": [
    {
      "label": "idx select: label matched by substring",
      "file": "../../src/lastlight/inputs/gefs.py",
      "oracle": "real",
      "find": "and entry.label == spec.label",
      "replace": "and spec.label in entry.label"
    },
    {
      "label": "idx select: level not checked",
      "file": "../../src/lastlight/inputs/gefs.py",
      "oracle": "real",
      "find": "and entry.level == \"entire atmosphere\"",
      "replace": "and True"
    },
    {
      "label": "idx parse: equal offsets accepted",
      "file": "../../src/lastlight/inputs/gefs.py",
      "oracle": "real",
      "find": "if entries and offset <= entries[-1].offset:",
      "replace": "if entries and offset < entries[-1].offset:"
    },
    {
      "label": "message check: parameter not checked",
      "file": "../../src/lastlight/inputs/gefs.py",
      "oracle": "real",
      "find": "if (message.discipline, message.category, message.number) != _EXPECTED_PARAMETER:",
      "replace": "if False:"
    },
    {
      "label": "message check: surface not checked",
      "file": "../../src/lastlight/inputs/gefs.py",
      "oracle": "real",
      "find": "if message.surface_type != _WHOLE_COLUMN:",
      "replace": "if False:"
    },
    {
      "label": "message check: aerosol type not checked",
      "file": "../../src/lastlight/inputs/gefs.py",
      "oracle": "real",
      "find": "if message.aerosol_type != spec.aerosol_type:",
      "replace": "if False:"
    },
    {
      "label": "message check: wavelength missing accepted",
      "file": "../../src/lastlight/inputs/gefs.py",
      "oracle": "real",
      "find": "if band is None or any(",
      "replace": "if band is not None and any("
    },
    {
      "label": "message check: forecast hour not checked",
      "file": "../../src/lastlight/inputs/gefs.py",
      "oracle": "real",
      "find": "if message.step_hours != plan.forecast_hour:",
      "replace": "if False:"
    },
    {
      "label": "download: length not checked",
      "file": "../../src/lastlight/inputs/gefs.py",
      "oracle": "real",
      "find": "if byte_range.length is not None and len(data) != byte_range.length:",
      "replace": "if False:"
    },
    {
      "label": "optical depth: negative packing noise kept (not floored to 0)",
      "file": "../../src/lastlight/inputs/gefs.py",
      "oracle": "real",
      "find": "return max(value, 0.0)",
      "replace": "return value"
    },
    {
      "label": "grid: second message on a different grid accepted",
      "file": "../../src/lastlight/inputs/gefs.py",
      "oracle": "real",
      "find": "elif not (",
      "replace": "elif False and not ("
    }
  ]
}
